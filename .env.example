# Copy this file to `.env.local` for local development.
# Next.js loads `.env.local` automatically. Do not commit real credentials.

# Database
MONGODB_URI=

# Authentication (Auth.js)
AUTH_SECRET=
# Local only. On Vercel do not set this to localhost.
# Use https://your-app.vercel.app or leave AUTH_URL unset.
AUTH_URL=http://localhost:3000

# AI Services (Phase 14 semantic matching)
# Local Sentence Transformers:
#   python -m uvicorn --app-dir ai-service main:app --host 127.0.0.1 --port 8001
# SEMANTIC_PROVIDER: auto | python | huggingface
AI_API_URL=http://127.0.0.1:8001
AI_API_KEY=
SEMANTIC_PROVIDER=auto
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# Job listings
# auto (default): Jooble (if JOOBLE_API_KEY is set) + SkillzDunya + JobDataAPI.
# Indeed has no public jobs API. Jooble is the closest official aggregator for Pakistan.
# Create a free key at https://pk.jooble.org/api/about (lifetime 500 requests).
# JOB_PROVIDER=adzuna requires ADZUNA_APP_ID and ADZUNA_APP_KEY.
JOB_PROVIDER=auto
JOOBLE_API_KEY=
JOOBLE_HOST=pk.jooble.org
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=pk

# Optional legacy key placeholder (unused by the default Remotive provider)
JOB_API_KEY=

# Application
NEXT_PUBLIC_API_URL=
NODE_ENV=development
