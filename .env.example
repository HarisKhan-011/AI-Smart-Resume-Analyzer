# Copy this file to `.env.local` for local development.
# Next.js loads `.env.local` automatically. Do not commit real credentials.

# Database
MONGODB_URI=

# Authentication (Auth.js)
AUTH_SECRET=

# Optional Auth.js URL for local development
AUTH_URL=http://localhost:3000

# AI Services (Phase 14 semantic matching)
# Local Sentence Transformers:
#   python -m uvicorn --app-dir ai-service main:app --host 127.0.0.1 --port 8001
# SEMANTIC_PROVIDER: auto | python | huggingface
AI_API_URL=http://127.0.0.1:8001
AI_API_KEY=
SEMANTIC_PROVIDER=auto
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# Job listings (Phase 10)
# Default provider is Remotive (public API, no key). Set JOB_PROVIDER=adzuna to switch.
JOB_PROVIDER=remotive
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Optional legacy key placeholder (unused by the default Remotive provider)
JOB_API_KEY=

# Application
NEXT_PUBLIC_API_URL=
NODE_ENV=development
